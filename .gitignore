# Clubhouse agent manager — 100% local orchestration runtime (per-agent worktrees,
# materialized personas/instructions, plugin caches). Nothing under here has ever been
# tracked; ignore the whole tree so it can't leak into a commit by accident.
.clubhouse/

# Claude Code — local runtime + skills. Skills and agent instructions are materialized
# per worktree by Clubhouse personas (agent/instance-local), not shared canonical repo
# config, so the whole directory is ignored — never track it.
.claude/

.mcp.json

# macOS Finder metadata
.DS_Store

# Root-level build artifacts & local junk that must never be committed (the app lives
# in app/; its real lockfile is app/package-lock.json, which IS tracked). These leaked
# in via #333 and were removed in the cleanup; ignore them so they can't return.
# (app's own build output — app/dist — is ignored by app/.gitignore.)
node_modules/
test-results/
/package-lock.json
