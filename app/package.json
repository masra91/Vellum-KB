{
  "name": "kb-app",
  "productName": "Vellum",
  "version": "0.1.0",
  "description": "AI-native second brain over an Obsidian/markdown vault.",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "walkthrough": "ALLOW_LOCAL_E2E=1 playwright test walkthrough.e2e.ts",
    "eval": "vitest run --config eval/vitest.config.ts",
    "eval:enrich": "vitest run --config eval/vitest.config.ts",
    "eval:scorecard": "vitest run --config eval/vitest.config.ts scorecard.eval.ts",
    "knip": "knip"
  },
  "keywords": [],
  "author": {
    "name": "Mason Allen",
    "email": "me@mason-allen.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.60.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/js-yaml": "4.0.9",
    "@types/turndown": "5.0.5",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "@vitest/coverage-v8": "3.2.4",
    "electron": "42.2.0",
    "eslint": "9.39.4",
    "happy-dom": "20.9.0",
    "js-yaml": "4.1.0",
    "knip": "^6.26.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/inter": "5.2.8",
    "@fontsource/spectral": "5.2.8",
    "@github/copilot-sdk": "1.0.0-beta.7",
    "better-sqlite3": "^12.11.1",
    "chokidar": "3.6.0",
    "dompurify": "3.4.5",
    "electron-squirrel-startup": "^1.0.1",
    "marked": "18.0.4",
    "pdfjs-dist": "4.7.76",
    "simple-git": "^3.36.0",
    "turndown": "7.2.0",
    "turndown-plugin-gfm": "1.0.2"
  }
}
